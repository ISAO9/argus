def generate_pdf(results: dict, histories: dict):
    import matplotlib; matplotlib.use('Agg')
    import matplotlib.pyplot as plt
    from matplotlib.backends.backend_pdf import PdfPages

    pdf_path = PDF_DIR / "13_05_ablation_study.pdf"
    conditions = list(results.keys())
    colors = {'Full ARGUS': '#2e7d32',
              'No GATv2':   '#c62828',
              'No S-P':     '#e65100',
              'No WaveEnc': '#1565c0'}

    with PdfPages(pdf_path) as pdf:

        # ── Page 1: Summary bar charts ──────────────────────────────
        fig, axes = plt.subplots(1, 3, figsize=(15, 6))
        fig.patch.set_facecolor('white')
        fig.suptitle(
            "ARGUS GNN-Locator — Ablation Study\n"
            "Component Contribution Analysis (K-NET Kumamoto 2016)",
            fontsize=13, color='#1a2a3a', fontweight='bold')

        def sa(ax, title):
            ax.set_facecolor('#f5f7fa')
            for sp in ax.spines.values(): sp.set_edgecolor('#c8d2dc')
            ax.tick_params(colors='#455a64', labelsize=9)
            ax.set_title(title, color='#1565c0', fontsize=10,
                         pad=6, fontweight='bold')

        # Horizontal error
        ax = axes[0]
        vals = [results[c]["horiz_median"] for c in conditions]
        cols = [colors.get(c, '#607080') for c in conditions]
        bars = ax.bar(conditions, vals, color=cols, alpha=0.85, width=0.5,
                      edgecolor='white', linewidth=0.8)
        for b, v in zip(bars, vals):
            ax.text(b.get_x()+b.get_width()/2, v+0.3,
                    f"{v:.1f}km", ha='center', fontsize=9, fontweight='700',
                    color='#1a2a3a')
        # Reference lines
        for ref_val, ref_col, ref_lbl in [(7.0,'#e65100','EQTransformer'),
                                           (5.0,'#e65100','PhaseLink'),
                                           (3.0,'#c62828','HYPOINVERSE')]:
            ax.axhline(y=ref_val, color=ref_col, lw=1, ls=':', alpha=0.6)
            ax.text(len(conditions)-0.4, ref_val+0.15,
                    ref_lbl, fontsize=7, color=ref_col, ha='right')
        sa(ax, "Horizontal Error (km, median)")
        ax.set_ylabel("Error (km)"); ax.tick_params(axis='x', rotation=15)

        # Depth error
        ax = axes[1]
        vals_d = [results[c]["dep_median"] for c in conditions]
        bars2 = ax.bar(conditions, vals_d, color=cols, alpha=0.85, width=0.5,
                       edgecolor='white', linewidth=0.8)
        for b, v in zip(bars2, vals_d):
            ax.text(b.get_x()+b.get_width()/2, v+0.05,
                    f"{v:.2f}km", ha='center', fontsize=9, fontweight='700',
                    color='#1a2a3a')
        sa(ax, "Depth Error (km, median)")
        ax.set_ylabel("Error (km)"); ax.tick_params(axis='x', rotation=15)

        # Degradation from Full ARGUS
        ax = axes[2]
        full_h = results["Full ARGUS"]["horiz_median"]
        degradations = [(results[c]["horiz_median"] - full_h) / full_h * 100
                        for c in conditions]
        cols_deg = ['#2e7d32' if d <= 0 else '#c62828' for d in degradations]
        bars3 = ax.bar(conditions, degradations, color=cols_deg,
                       alpha=0.85, width=0.5, edgecolor='white')
        for b, v in zip(bars3, degradations):
            ax.text(b.get_x()+b.get_width()/2,
                    v + (1 if v >= 0 else -3),
                    f"{v:+.1f}%", ha='center', fontsize=9, fontweight='700',
                    color='#1a2a3a')
        ax.axhline(y=0, color='#1a2a3a', lw=1.5)
        sa(ax, "Degradation vs Full ARGUS (%)")
        ax.set_ylabel("Δ Error (%)"); ax.tick_params(axis='x', rotation=15)

        plt.tight_layout()
        pdf.savefig(fig, dpi=150, bbox_inches='tight', facecolor='white')
        plt.close(fig)

        # ── Page 2: Training curves ──────────────────────────────────
        fig, axes = plt.subplots(1, 2, figsize=(14, 5))
        fig.patch.set_facecolor('white')
        fig.suptitle("Ablation Study — Training Curves",
                     fontsize=12, color='#1a2a3a', fontweight='bold')

        for ax, split in zip(axes, ["train", "val"]):
            for cond, hist in histories.items():
                if split in hist and hist[split]:
                    ep = range(1, len(hist[split])+1)
                    ax.plot(ep, hist[split],
                            color=colors.get(cond, '#607080'),
                            lw=1.5, label=cond)
            sa(ax, f"{split.capitalize()} Loss (NLL)")
            ax.set_xlabel("Epoch"); ax.set_ylabel("NLL")
            ax.legend(fontsize=8, framealpha=0.8)

        plt.tight_layout()
        pdf.savefig(fig, dpi=150, bbox_inches='tight', facecolor='white')
        plt.close(fig)

        # ── Page 3: Summary table ────────────────────────────────────
        fig, ax = plt.subplots(figsize=(13, 5))
        fig.patch.set_facecolor('white')
        ax.axis('off')
        ax.set_title(
            "ARGUS Ablation Study — Performance Summary\n"
            "K-NET Kumamoto 2016 (n=104 test events)",
            fontsize=12, color='#1a2a3a', fontweight='bold', pad=20)

        col_labels = ["Condition", "GATv2", "S-P Features",
                      "Wave Enc.", "Horiz(km)", "Depth(km)",
                      "p75(km)", "Latency"]
        component_flags = {
            "Full ARGUS":  ("✓", "✓", "✓"),
            "No GATv2":    ("✗", "✓", "✓"),
            "No S-P":      ("✓", "✗", "✓"),
            "No WaveEnc":  ("✓", "✓", "✗"),
        }
        rows = []
        for cond in conditions:
            r = results[cond]
            g, s, w = component_flags.get(cond, ("?","?","?"))
            rows.append([
                cond, g, s, w,
                f"{r['horiz_median']:.2f}",
                f"{r['dep_median']:.2f}",
                f"{r['horiz_p75']:.2f}",
                f"{r['latency_ms']:.1f}ms",
            ])

        tbl = ax.table(cellText=rows, colLabels=col_labels,
                       cellLoc='center', loc='center',
                       bbox=[0, 0, 1, 0.85])
        tbl.auto_set_font_size(False); tbl.set_fontsize(10)
        tbl.scale(1, 2.2)
        # Header styling
        for j in range(len(col_labels)):
            tbl[0,j].set_facecolor('#1565c0')
            tbl[0,j].set_text_props(color='white', fontweight='bold')
        # Full ARGUS row highlight
        for j in range(len(col_labels)):
            tbl[1,j].set_facecolor('#e8f5e9')
        # ✗ rows highlight
        for i, cond in enumerate(conditions[1:], start=2):
            for j in range(len(col_labels)):
                tbl[i,j].set_facecolor('#fff8f5')

        plt.tight_layout()
        pdf.savefig(fig, dpi=150, bbox_inches='tight', facecolor='white')
        plt.close(fig)

    log.info(f"  PDF: {pdf_path}")


