def main():
    parser = argparse.ArgumentParser(
        description="ARGUS Script 13_05 — Ablation Study")
    parser.add_argument("--graph_pt",   type=str,
                        default="data/locator/hinet_graph_v2.pt")
    parser.add_argument("--knet_cache", type=str,
                        default="data/knet_processed/knet_parsed.pt")
    parser.add_argument("--epochs",     type=int,   default=40)
    parser.add_argument("--lr",         type=float, default=5e-4)
    parser.add_argument("--patience",   type=int,   default=15)
    parser.add_argument("--skip_full",  action="store_true",
                        help="Skip Full ARGUS training (use best_locator_finetune.pt)")
    parser.add_argument("--device",     type=str,   default="auto")
    args = parser.parse_args()

    log.info("="*65)
    log.info("  ARGUS  |  Script 13_05  |  Ablation Study")
    log.info("="*65)

    dev = torch.device("mps" if torch.backends.mps.is_available()
                       else "cuda" if torch.cuda.is_available()
                       else "cpu") if args.device=="auto" \
          else torch.device(args.device)
    log.info(f"  Device: {dev}")

    # ── Load synthetic graph dataset ──────────────────────────────
    gpt = Path(args.graph_pt) if Path(args.graph_pt).is_absolute() \
          else PROJECT_ROOT/args.graph_pt
    log.info(f"\n  Synthetic graph dataset: {gpt}")
    pdata     = torch.load(gpt, map_location="cpu", weights_only=False)
    ns        = pdata["norm_stats"]
    synth_tr  = pdata["graph_data"]["train"]
    synth_val = pdata["graph_data"]["val"]
    synth_te  = pdata["graph_data"]["test"]
    node_dim  = synth_tr[0]["x"].shape[1]
    edge_dim  = synth_tr[0]["edge_attr"].shape[1]
    log.info(f"  Synth: train={len(synth_tr)}  val={len(synth_val)}  "
             f"test={len(synth_te)}")
    log.info(f"  node_dim={node_dim}  edge_dim={edge_dim}")

    # ── Load K-NET real test graphs (from 13_04 cache) ────────────
    cache_path = Path(args.knet_cache) if Path(args.knet_cache).is_absolute() \
                 else PROJECT_ROOT/args.knet_cache
    knet_test = None
    if cache_path.exists():
        log.info(f"\n  K-NET cache: {cache_path}")
        knet_evs = torch.load(cache_path, weights_only=False)

        # Rebuild graphs from cache using 13_01
        import importlib.util as ilu
        spec01 = ilu.spec_from_file_location("gnn01",
                    PROJECT_ROOT/"src"/"13_01_build_hinet_graph.py")
        mod01  = ilu.module_from_spec(spec01); spec01.loader.exec_module(mod01)

        enc = mod01.WaveformEncoder(3, pdata["wave_emb_dim"],
                                      knet_evs[0]["waveforms"].shape[-1]).to(dev)
        if "encoder_state" in pdata:
            enc.load_state_dict(pdata["encoder_state"])
        enc.eval()

        rng  = np.random.default_rng(42)
        idx  = rng.permutation(len(knet_evs))
        n_tr = int(len(idx)*.70); n_va = int(len(idx)*.15)
        test_evs = [knet_evs[i] for i in idx[n_tr+n_va:]]

        knet_test = []
        for ev in test_evs:
            wavs = ev["waveforms"]; sta = ev["sta_locs"]
            with torch.no_grad():
                wavs_t = torch.nan_to_num(
                    torch.from_numpy(wavs).to(dev), nan=0.0).clamp(-10,10)
                emb = enc(wavs_t).cpu().numpy()
                emb = np.nan_to_num(emb, nan=0.0)
            ei, ea = mod01.build_edges_knn(sta, k=4)
            fnet = {"lat":float(ev["src_loc"][0]),
                    "lon":float(ev["src_loc"][1]),
                    "depth_km":float(ev["src_loc"][2])}
            g = mod01.build_graph_for_event(
                waveforms=wavs, sta_locs=sta,
                tp_times=ev["tp_times"], sp_diffs=ev["sp_diffs"],
                snr=ev["snr"], src_loc=np.array(
                    [fnet["lat"],fnet["lon"],max(0.5,fnet["depth_km"])],
                    np.float32),
                mw=float(ev["mw"]), edge_index=ei, edge_attr_geo=ea,
                norm_stats=ns, wave_emb=emb)
            x = g["x"] if isinstance(g["x"], torch.Tensor) \
                else torch.tensor(g["x"])
            x_clean = torch.nan_to_num(x, nan=0.0).clamp(-5, 5)
            # GraphDataset expects numpy array for "x"
            g["x"] = x_clean.numpy() if isinstance(x_clean, torch.Tensor)                      else x_clean
            knet_test.append(g)
        log.info(f"  K-NET test: {len(knet_test)} events")
    else:
        log.warning("  K-NET cache not found → using synthetic test only")
        knet_test = synth_te

    # ── Load GNN model class ──────────────────────────────────────
    import importlib.util as ilu
    spec02 = ilu.spec_from_file_location("gnn02",
                PROJECT_ROOT/"src"/"13_02_gnn_locator_model.py")
    mod02  = ilu.module_from_spec(spec02); spec02.loader.exec_module(mod02)
    GNNLocator = mod02.GNNLocator

    def make_gnn():
        return GNNLocator(node_dim=node_dim, edge_dim=edge_dim,
                          hidden=128, heads=4, n_layers=4,
                          dropout=0.1).to(dev)

    results   = {}
    histories = {}

    # ══════════════════════════════════════════════════════════════
    # CONDITION 1: Full ARGUS
    # ══════════════════════════════════════════════════════════════
    log.info("\n" + "="*55)
    log.info("  Condition 1/4: Full ARGUS (baseline)")
    log.info("="*55)

    if args.skip_full:
        ft_path = MODEL_DIR / "best_locator_finetune.pt"
        if ft_path.exists():
            log.info(f"  Loading fine-tuned model: {ft_path}")
            ck = torch.load(ft_path, map_location=dev, weights_only=False)
            m_full = make_gnn()
            m_full.load_state_dict(ck["model_state"])
            histories["Full ARGUS"] = {"train": [], "val": []}
        else:
            log.warning("  Fine-tuned model not found, training from scratch")
            args.skip_full = False

    if not args.skip_full:
        m_full = make_gnn()
        hist, _ = train_model(m_full, synth_tr, synth_val, dev,
                               epochs=args.epochs, lr=args.lr,
                               patience=args.patience,
                               condition_name="Full ARGUS")
        # Load best
        ck = torch.load(MODEL_DIR/"ablation_Full ARGUS.pt",
                        map_location=dev, weights_only=False)
        m_full.load_state_dict(ck["model_state"])
        histories["Full ARGUS"] = hist

    results["Full ARGUS"] = evaluate_condition(m_full, knet_test, ns, dev)
    log.info(f"  Full ARGUS: horiz={results['Full ARGUS']['horiz_median']:.2f}km  "
             f"depth={results['Full ARGUS']['dep_median']:.2f}km")

    # ══════════════════════════════════════════════════════════════
    # CONDITION 2: No GATv2 (MLP only)
    # ══════════════════════════════════════════════════════════════
    log.info("\n" + "="*55)
    log.info("  Condition 2/4: No GATv2 (MLP locator)")
    log.info("="*55)

    m_mlp = MLPLocator(node_dim=node_dim, hidden=128, dropout=0.1).to(dev)
    hist_mlp, _ = train_model(m_mlp, synth_tr, synth_val, dev,
                               epochs=args.epochs, lr=args.lr,
                               patience=args.patience,
                               condition_name="No GATv2")
    ck = torch.load(MODEL_DIR/"ablation_No GATv2.pt",
                    map_location=dev, weights_only=False)
    m_mlp.load_state_dict(ck["model_state"])
    results["No GATv2"]   = evaluate_condition(m_mlp, knet_test, ns, dev)
    histories["No GATv2"] = hist_mlp
    log.info(f"  No GATv2: horiz={results['No GATv2']['horiz_median']:.2f}km  "
             f"depth={results['No GATv2']['dep_median']:.2f}km")

    # ══════════════════════════════════════════════════════════════
    # CONDITION 3: No S-P Features
    # ══════════════════════════════════════════════════════════════
    log.info("\n" + "="*55)
    log.info("  Condition 3/4: No S-P Features")
    log.info("="*55)

    sp_train = mask_sp_features(synth_tr)
    sp_val   = mask_sp_features(synth_val)
    sp_test  = mask_sp_features(knet_test)

    m_nosp = make_gnn()
    hist_nosp, _ = train_model(m_nosp, sp_train, sp_val, dev,
                                epochs=args.epochs, lr=args.lr,
                                patience=args.patience,
                                condition_name="No S-P")
    ck = torch.load(MODEL_DIR/"ablation_No S-P.pt",
                    map_location=dev, weights_only=False)
    m_nosp.load_state_dict(ck["model_state"])
    results["No S-P"]   = evaluate_condition(m_nosp, sp_test, ns, dev)
    histories["No S-P"] = hist_nosp
    log.info(f"  No S-P: horiz={results['No S-P']['horiz_median']:.2f}km  "
             f"depth={results['No S-P']['dep_median']:.2f}km")

    # ══════════════════════════════════════════════════════════════
    # CONDITION 4: No Wave Encoder
    # ══════════════════════════════════════════════════════════════
    log.info("\n" + "="*55)
    log.info("  Condition 4/4: No Wave Encoder")
    log.info("="*55)

    we_train = mask_wave_features(synth_tr)
    we_val   = mask_wave_features(synth_val)
    we_test  = mask_wave_features(knet_test)

    m_nowe = make_gnn()
    hist_nowe, _ = train_model(m_nowe, we_train, we_val, dev,
                                epochs=args.epochs, lr=args.lr,
                                patience=args.patience,
                                condition_name="No WaveEnc")
    ck = torch.load(MODEL_DIR/"ablation_No WaveEnc.pt",
                    map_location=dev, weights_only=False)
    m_nowe.load_state_dict(ck["model_state"])
    results["No WaveEnc"]   = evaluate_condition(m_nowe, we_test, ns, dev)
    histories["No WaveEnc"] = hist_nowe
    log.info(f"  No WaveEnc: horiz={results['No WaveEnc']['horiz_median']:.2f}km  "
             f"depth={results['No WaveEnc']['dep_median']:.2f}km")

    # ══════════════════════════════════════════════════════════════
    # SUMMARY
    # ══════════════════════════════════════════════════════════════
    log.info("\n  ══ Ablation Study Results ════════════════════════")
    log.info(f"  {'Condition':<18} {'Horiz(km)':>10} {'Depth(km)':>10} "
             f"{'Δ Horiz':>10} {'Latency':>10}")
    log.info("  " + "-"*60)
    full_h = results["Full ARGUS"]["horiz_median"]
    for cond, res in results.items():
        delta = res["horiz_median"] - full_h
        sign  = "+" if delta >= 0 else ""
        log.info(f"  {cond:<18} {res['horiz_median']:>10.2f} "
                 f"{res['dep_median']:>10.2f} "
                 f"{sign+f'{delta:.2f}km':>10} "
                 f"{res['latency_ms']:>9.1f}ms")

    generate_pdf(results, histories)

    log.info("="*65)
    log.info("  Script 13_05 complete.")
    log.info(f"  PDF: {PDF_DIR}/13_05_ablation_study.pdf")
    log.info("="*65)


if __name__ == "__main__":
    main()
