# =============================================================================
# ABLATION MODEL VARIANTS
# =============================================================================

class MLPLocator(nn.Module):
    """
    アブレーション① : GATv2なし版
    グラフ構造を無視して各局の特徴量をMLPで処理し
    全局の特徴をpoolingして震源推定する。
    GATv2を使わないため局間の情報伝達がない。
    """
    def __init__(self, node_dim: int, hidden: int = 128, dropout: float = 0.1):
        super().__init__()
        self.node_enc = nn.Sequential(
            nn.Linear(node_dim, hidden), nn.GELU(), nn.Dropout(dropout),
            nn.Linear(hidden, hidden),  nn.GELU(), nn.Dropout(dropout),
            nn.Linear(hidden, hidden),
        )
        self.pool_mlp = nn.Sequential(
            nn.Linear(hidden, hidden*2), nn.GELU(), nn.Dropout(dropout),
            nn.Linear(hidden*2, hidden),
        )
        self.mu_head  = nn.Linear(hidden, 3)
        self.var_head = nn.Linear(hidden, 3)

    def forward(self, x, edge_index, edge_attr):
        # x: (N, node_dim) — ignore graph structure
        h = self.node_enc(x)                     # (N, hidden)
        h = h.mean(dim=0, keepdim=True)          # (1, hidden) — mean pooling
        h = self.pool_mlp(h).squeeze(0)          # (hidden,)
        mu     = self.mu_head(h)
        log_var= self.var_head(h)
        log_var= torch.clamp(log_var, -4, 4)
        return mu, log_var


def mask_sp_features(graph_data: list) -> list:
    """S-P特徴なし: tp(dim3) / sp_diffs(dim4) を0マスク。numpy形式で返す。"""
    masked = []
    for g in graph_data:
        g2 = {}
        for k, v in g.items():
            g2[k] = v.numpy() if isinstance(v, torch.Tensor) else                     (v.copy() if isinstance(v, np.ndarray) else v)
        g2["x"] = g2["x"].copy().astype(np.float32)
        g2["x"][:, 3] = 0.0  # tp_times
        g2["x"][:, 4] = 0.0  # sp_diffs
        masked.append(g2)
    return masked

def mask_wave_features(graph_data: list) -> list:
    """波形エンコーダなし: wave_emb(dim6~) を0マスク。numpy形式で返す。"""
    masked = []
    for g in graph_data:
        g2 = {}
        for k, v in g.items():
            g2[k] = v.numpy() if isinstance(v, torch.Tensor) else                     (v.copy() if isinstance(v, np.ndarray) else v)
        g2["x"] = g2["x"].copy().astype(np.float32)
        g2["x"][:, 6:] = 0.0  # wave_emb
        masked.append(g2)
    return masked


def train_model(model, train_graphs, val_graphs, device,
                epochs=40, lr=5e-4, patience=15,
                condition_name=""):
    """
    汎用学習ループ。Full ARGUSとMLP variant両方に対応。
    """
    import importlib.util
    spec = importlib.util.spec_from_file_location(
        "gnn02", PROJECT_ROOT/"src"/"13_02_gnn_locator_model.py")
    mod = importlib.util.module_from_spec(spec); spec.loader.exec_module(mod)
    DS  = mod.GraphDataset
    nll = mod.heteroscedastic_nll

    tds = DS(train_graphs); vds = DS(val_graphs)
    opt = torch.optim.AdamW(model.parameters(), lr=lr, weight_decay=1e-4)
    sch = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=epochs, eta_min=lr*0.01)

    best_loss, patience_cnt = float('inf'), 0
    history = {"train": [], "val": []}

    log.info(f"\n  [{condition_name}] Training: {epochs}ep  "
             f"Train:{len(tds)}  Val:{len(vds)}")

    for ep in range(1, epochs+1):
        model.train(); tr=0.0; tr_n=0
        for i in torch.randperm(len(tds)).tolist():
            g = tds[i]
            x  = torch.nan_to_num(g["x"].to(device), nan=0.0).clamp(-5,5)
            ei = g["edge_index"].to(device)
            ea = g["edge_attr"].to(device)
            y  = g["y"].to(device)
            opt.zero_grad()
            mu, lv = model(x, ei, ea)
            loss = nll(mu, lv, y)
            if torch.isnan(loss) or torch.isinf(loss): continue
            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
            opt.step(); tr+=loss.item(); tr_n+=1
        tr = tr/max(tr_n,1) if tr_n>0 else float('nan')

        model.eval(); vl=0.0; vl_n=0
        with torch.no_grad():
            for i in range(len(vds)):
                g = vds[i]
                x = torch.nan_to_num(g["x"].to(device), nan=0.0).clamp(-5,5)
                mu, lv = model(x, g["edge_index"].to(device), g["edge_attr"].to(device))
                v_loss = nll(mu, lv, g["y"].to(device))
                if not (torch.isnan(v_loss) or torch.isinf(v_loss)):
                    vl+=v_loss.item(); vl_n+=1
        vl = vl/max(vl_n,1) if vl_n>0 else float('nan')

        history["train"].append(tr); history["val"].append(vl)
        sch.step()

        if not np.isnan(vl) and vl < best_loss:
            best_loss=vl; patience_cnt=0
            torch.save({"model_state": model.state_dict(),
                        "epoch": ep, "val_loss": best_loss},
                       MODEL_DIR/f"ablation_{condition_name}.pt")
        else:
            patience_cnt+=1

        if ep % 10 == 0 or ep == 1:
            log.info(f"  [{condition_name}] ep{ep:3d}  "
                     f"tr={tr:.4f}  val={vl:.4f}")

        if patience_cnt >= patience:
            log.info(f"  [{condition_name}] Early stop ep{ep}")
            break

    return history, best_loss


# =============================================================================
# EVALUATION
# =============================================================================

@torch.no_grad()
def evaluate_condition(model, test_graphs, norm_stats, device) -> dict:
    import importlib.util
    spec = importlib.util.spec_from_file_location(
        "gnn02", PROJECT_ROOT/"src"/"13_02_gnn_locator_model.py")
    mod = importlib.util.module_from_spec(spec); spec.loader.exec_module(mod)
    ds = mod.GraphDataset(test_graphs); ns = norm_stats
    model.eval(); h, d, lats = [], [], []
    for i in range(len(ds)):
        g = ds[i]
        x = torch.nan_to_num(g["x"].to(device), nan=0.0).clamp(-5,5)
        t0 = time.perf_counter()
        mu, _ = model(x, g["edge_index"].to(device), g["edge_attr"].to(device))
        if device.type == "mps": torch.mps.synchronize()
        lats.append((time.perf_counter()-t0)*1000)
        mu_np = mu.cpu().numpy()
        lp  = mu_np[0]*ns["lat_std"]+ns["lat_mean"]
        lonp= mu_np[1]*ns["lon_std"]+ns["lon_mean"]
        dp  = float(np.exp(np.clip(mu_np[2],0,1)*np.log(60.0)))
        src = g["src_loc"]
        dlat=(lp-float(src[0]))*111.0
        dlon=(lonp-float(src[1]))*111.0*np.cos(np.radians(float(src[0])))
        h.append(np.sqrt(dlat**2+dlon**2))
        d.append(abs(dp-float(src[2])))
    return {
        "horiz_median": float(np.median(h)),
        "horiz_mean":   float(np.mean(h)),
        "horiz_p75":    float(np.percentile(h, 75)),
        "dep_median":   float(np.median(d)),
        "latency_ms":   float(np.median(lats)),
        "n":            len(h),
    }


